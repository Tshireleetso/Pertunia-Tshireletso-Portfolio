.hero .wrap {
  display: flex;
  align-items: center;        /* vertically centers text with image */
  justify-content: space-between;
}

.hero-text {
  flex: 1;
  max-width: 50%;             /* keeps text balanced next to image */
}

.hero-photo-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
}
