.hero .wrap {
  display: flex;
  align-items: center;        /* vertically centers text with image */
  justify-content: space-between; /* text left, image right */
}

.hero-text {
  flex: 1;
  max-width: 50%;             /* keeps text balanced */
  text-align: left;           /* ensures text stays left-aligned */
}

.hero-photo-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;  /* pushes image to the right */
}
